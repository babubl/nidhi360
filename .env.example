# Copy to .env.local for local development. In GitHub, add these as repository
# Variables (Settings > Secrets and variables > Actions > Variables).

# URL of the deployed AI proxy (worker/), e.g. https://nidhi360-ai.<you>.workers.dev
VITE_ASK_URL=

# WhatsApp number for "Talk to a PF expert", international format without +, e.g. 919876543210
VITE_WHATSAPP_NUMBER=

# Email shown on the For employers page
VITE_CONTACT_EMAIL=
